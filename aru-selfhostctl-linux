#!/usr/bin/env bash
set -Eeuo pipefail

INSTANCE="home"
BASE_ROOT="${ARU_LINUX_BASE_ROOT:-${XDG_DATA_HOME:-$HOME/.local/share}/aru-host}"
CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"

usage() {
  cat <<'EOF'
Usage: aru-selfhost [--instance NAME] <command>

  status                 Show user-service state and installed release.
  pairing                Restart and print a fresh ten-minute pairing link.
  doctor                 Verify runtime, service, manifest, and capabilities.
  logs                   Follow private stdout/stderr logs.
  upgrade [--ref REF]    Install a new release with persisted choices.
  rollback               Switch to the previous healthy release.
  uninstall              Remove program/config and preserve durable data.
  uninstall --purge-data Remove this instance including durable data.
EOF
}
die() { echo "aru-selfhost: $*" >&2; exit 1; }

while (($#)); do
  case "$1" in
    --instance) INSTANCE="${2:?missing value for --instance}"; shift 2 ;;
    --base-root) BASE_ROOT="${2:?missing value for --base-root}"; shift 2 ;;
    *) break ;;
  esac
done
[[ "$INSTANCE" =~ ^[a-z0-9][a-z0-9-]{0,31}$ ]] || die "invalid instance"

INSTANCE_ROOT="$BASE_ROOT/instances/$INSTANCE"
CONFIG_DIR="$INSTANCE_ROOT/config"
INSTALL_ENV="$CONFIG_DIR/install.env"
NODE_ENV="$CONFIG_DIR/node.env"
CURRENT_LINK="$INSTANCE_ROOT/current"
PREVIOUS_LINK="$INSTANCE_ROOT/previous"
LOG_DIR="$INSTANCE_ROOT/logs"
UNIT_NAME="aru-host-$INSTANCE.service"

load_install_config() { [[ -r "$INSTALL_ENV" ]] || die "instance not installed"; source "$INSTALL_ENV"; }
load_node_config() { [[ -r "$NODE_ENV" ]] || die "node config missing"; source "$NODE_ENV"; }
installed_release() { local target; target="$(readlink "$CURRENT_LINK" 2>/dev/null || true)"; printf '%s\n' "${target##*/}"; }

restart_service() { systemctl --user restart "$UNIT_NAME"; }
status_command() {
  echo "instance: $INSTANCE"
  echo "release: $(installed_release)"
  systemctl --user status "$UNIT_NAME" --no-pager
}
pairing_command() {
  load_node_config
  : > "$LOG_DIR/stdout.log"
  restart_service
  local output link
  for _ in {1..60}; do
    output="$(cat "$LOG_DIR/stdout.log" 2>/dev/null || true)"
    link="$(printf '%s\n' "$output" | grep -E '^aru://pair\?' | tail -1 || true)"
    if [[ -n "$link" ]]; then
      echo "$link"
      echo "Single use; expires in ten minutes. The next restart invalidates it."
      return
    fi
    sleep 0.25
  done
  die "service restarted but no pairing link appeared"
}
doctor_command() {
  load_node_config
  local failed=false manifest
  echo "instance: $INSTANCE"
  echo "release: $(installed_release)"
  if systemctl --user is-active --quiet "$UNIT_NAME"; then echo "service: active"; else echo "service: inactive"; failed=true; fi
  if [[ -x "$ARU_NODE_BINARY" ]]; then echo "node: $($ARU_NODE_BINARY --version)"; else echo "node: missing"; failed=true; fi
  if [[ "$ARU_CONTAINER_RUNTIME" == "none" ]]; then
    echo "container: unavailable (workspace/OCI plugin execution disabled)"
  elif command -v "$ARU_CONTAINER_RUNTIME" >/dev/null 2>&1 && "$ARU_CONTAINER_RUNTIME" info >/dev/null 2>&1; then
    echo "container: $($ARU_CONTAINER_RUNTIME --version | head -1)"
  else echo "container: configured but unavailable"; failed=true; fi
  if manifest="$(curl -fsS "http://127.0.0.1:$ARU_PORT/.well-known/aru.json" 2>/dev/null)"; then
    printf '%s' "$manifest" | "$ARU_NODE_BINARY" -e 'let b="";process.stdin.on("data",c=>b+=c);process.stdin.on("end",()=>{const m=JSON.parse(b);console.log(`manifest: ok (${m.serverId}, ${m.nodeKind})`)})'
  else echo "manifest: unreachable"; failed=true; fi
  [[ "$failed" == false ]]
}
upgrade_command() {
  load_install_config
  local ref="${ARU_INSTALL_SOURCE_REF:-main}" explicit=false installer="$CURRENT_LINK/install-linux-desktop.sh"
  if [[ "${1:-}" == "--ref" ]]; then ref="${2:?missing ref}"; explicit=true; shift 2; fi
  (($# == 0)) || die "unknown upgrade arguments"
  local args=(--instance "$INSTANCE" --base-root "$BASE_ROOT" --base-url "$ARU_INSTALL_BASE_URL" --display-name "$ARU_INSTALL_DISPLAY_NAME" --port "$ARU_INSTALL_PORT")
  if [[ -n "${ARU_INSTALL_SOURCE_DIR:-}" && -d "$ARU_INSTALL_SOURCE_DIR" && "$explicit" == false ]]; then
    installer="$ARU_INSTALL_SOURCE_DIR/install-linux-desktop.sh"; args+=(--source-dir "$ARU_INSTALL_SOURCE_DIR")
  elif [[ -n "${ARU_INSTALL_BUNDLE_URL:-}" && "$explicit" == false ]]; then args+=(--bundle-url "$ARU_INSTALL_BUNDLE_URL")
  else args+=(--source-ref "$ref"); fi
  "$installer" "${args[@]}"
}
rollback_command() {
  local current previous
  current="$(readlink "$CURRENT_LINK" 2>/dev/null || true)"
  previous="$(readlink "$PREVIOUS_LINK" 2>/dev/null || true)"
  [[ -n "$current" && -n "$previous" ]] || die "no previous release"
  systemctl --user stop "$UNIT_NAME"
  ln -sfn "$current" "$PREVIOUS_LINK"
  ln -sfn "$previous" "$CURRENT_LINK"
  systemctl --user start "$UNIT_NAME"
  echo "rolled back to ${previous##*/}"
}
uninstall_command() {
  load_install_config
  local args=(--instance "$INSTANCE" --base-root "$BASE_ROOT" --uninstall)
  [[ "${1:-}" == "--purge-data" ]] && args+=(--purge-data) && shift
  (($# == 0)) || die "unknown uninstall arguments"
  "$CURRENT_LINK/install-linux-desktop.sh" "${args[@]}"
}

command_name="${1:-}"; [[ -n "$command_name" ]] || { usage; exit 1; }; shift
case "$command_name" in
  status) status_command "$@" ;;
  pairing) pairing_command "$@" ;;
  doctor) doctor_command "$@" ;;
  logs) touch "$LOG_DIR/stdout.log" "$LOG_DIR/stderr.log"; exec tail -F "$LOG_DIR/stdout.log" "$LOG_DIR/stderr.log" ;;
  upgrade) upgrade_command "$@" ;;
  rollback) rollback_command "$@" ;;
  uninstall) uninstall_command "$@" ;;
  help|--help|-h) usage ;;
  *) usage; die "unknown command: $command_name" ;;
esac
