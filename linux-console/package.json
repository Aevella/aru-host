{
  "name": "aru-host",
  "version": "0.30.2",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "desktopName": "cn.aelion.aru.host-console.linux.desktop",
  "description": "Aru Host desktop Console for Debian and Ubuntu",
  "homepage": "https://github.com/Aevella/aru-host",
  "author": {
    "name": "Aevella",
    "email": "Aevella@users.noreply.github.com"
  },
  "main": "src/main.mjs",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "pack:dir": "npm run prepare:assets && electron-builder --dir --linux",
    "dist:deb": "npm run prepare:assets && electron-builder --linux deb"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "sharp": "^0.35.3"
  },
  "build": {
    "appId": "cn.aelion.aru.host-console.linux",
    "productName": "Aru Host",
    "asar": true,
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "node_modules/qrcode/**/*"
    ],
    "extraResources": [
      {
        "from": ".host-core",
        "to": "HostCore"
      }
    ],
    "directories": {
      "output": "dist",
      "buildResources": ".build-icons"
    },
    "linux": {
      "target": [
        "deb"
      ],
      "category": "Utility",
      "executableName": "aru-host",
      "syncDesktopName": true,
      "icon": ".build-icons/icon.png",
      "artifactName": "aru-host-linux-${version}-${arch}.${ext}"
    },
    "deb": {
      "depends": [
        "bash",
        "ca-certificates",
        "curl",
        "libasound2t64 | libasound2",
        "libatspi2.0-0t64 | libatspi2.0-0",
        "libgtk-3-0t64 | libgtk-3-0",
        "libsecret-tools",
        "libsecret-1-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "libuuid1",
        "systemd",
        "tar",
        "xdg-utils"
      ],
      "priority": "optional"
    }
  }
}
